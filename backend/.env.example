# Local development: no external database required
DATABASE_URL=sqlite:///./fines.db
FRONTEND_ORIGIN=http://localhost:5173
# Local demo only: allows sign-in by database user ID without a password.
# Keep disabled anywhere that is reachable by other users.
ALLOW_USER_ID_LOGIN=false
# SQL Server: comment out/remove DATABASE_URL before enabling DB_SERVER.
# The Windows account running the backend must have access to the database.
# Install backend/requirements-sqlserver.txt and Microsoft ODBC Driver 18.
# DB_AUTH=windows
# DB_SERVER=your-server-name,1433
# DB_NAME=your-database-name
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_TRUST_CERTIFICATE=no
# For SQL Server authentication instead, set DB_AUTH=sql and provide:
# DB_USERNAME=
# DB_PASSWORD=
